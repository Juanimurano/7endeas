{
  "name": "7-endeas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.md .env.example .gitignore --ignore-unknown",
    "format:check": "prettier --check apps packages tests scripts *.json *.ts *.md --ignore-unknown",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.mjs",
    "start": "node dist/server/main.mjs",
    "generate:cards": "node --env-file-if-exists=.env scripts/generate-cards.mjs",
    "import:cards": "node scripts/import-special-cards.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
